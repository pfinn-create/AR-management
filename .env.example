# Copy this to .env and fill in values

# Security
SECRET_KEY=your-very-secret-key-change-this

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-...

# Gmail OAuth (https://console.cloud.google.com)
# Create an OAuth 2.0 Client ID (Web Application type)
# Add http://localhost:8000/gmail/callback as an Authorized Redirect URI
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/gmail/callback

FRONTEND_URL=http://localhost:3000

# Microsoft / Outlook OAuth (https://portal.azure.com)
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=

# Database (auto-set by Docker, override for local dev)
DATABASE_URL=postgresql://aruser:arpassword@localhost:5432/ardb
