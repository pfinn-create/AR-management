# Copy this to .env and fill in values

# Security
SECRET_KEY=your-very-secret-key-change-this

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-...

# Gmail OAuth (https://console.cloud.google.com)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Microsoft / Outlook OAuth (https://portal.azure.com)
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=

# Database (auto-set by Docker, override for local dev)
DATABASE_URL=postgresql://aruser:arpassword@localhost:5432/ardb
